# MarketCoach environment variables
#
# Copy this file to .env and fill in the required values. .env is gitignored
# so your secrets never reach the repo.
#
# For production deployments (Railway, etc.) see DEPLOY.md at the repo root.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — every agent call uses this. App won't start without it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token for the HTTP API. Empty = dev mode, no auth required.
# Set this to a strong random string for any non-local deployment.
API_SECRET=

# CORS allowed origins (JSON array of strings).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────

# SQLite for local dev. For Railway with a mounted volume, use:
#   sqlite:////data/marketcoach.db    (four slashes = absolute path)
DATABASE_URL=sqlite:///./marketcoach.db

# ─────────────────────────────────────────────────────────────────────────────
# BROKER SELECTION
# ─────────────────────────────────────────────────────────────────────────────

# Which broker the app talks to. Options:
#   ibkr  — Interactive Brokers via ib_insync + IB Gateway (the only
#           currently-supported live broker; Alpaca was removed because
#           it doesn't onboard Brazilian residents for live trading)
#   none  — No broker. Trading endpoints return 503. Use this for cloud-
#           hosted analysis services that can't reach a local Gateway.
BROKER_PROVIDER=ibkr

# ── IBKR connection (only used when BROKER_PROVIDER=ibkr) ──
# IBKR requires a local IB Gateway or TWS process, not direct internet.
# Ports: 7497/4002 = paper, 7496/4001 = live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ─────────────────────────────────────────────────────────────────────────────
# REAL-CAPITAL SAFETY GATE
# ─────────────────────────────────────────────────────────────────────────────
#
# Going live requires BOTH of these flipped. Either one alone is silently
# ignored — the app falls back to paper with a loud warning. Applies to
# whichever broker is active; the variable names are historical.
#
# To activate live mode, set BOTH:
#   ALPACA_PAPER=false
#   ALPACA_LIVE_CONFIRMATION=I understand this uses real capital
ALPACA_PAPER=true
ALPACA_LIVE_CONFIRMATION=

# ─────────────────────────────────────────────────────────────────────────────
# SCHEDULER
# ─────────────────────────────────────────────────────────────────────────────

# Timezone for cron-triggered jobs (weekly plan, morning brief). Any
# IANA zone name. Empty = server local time. On Railway (UTC), set this
# explicitly so schedules fire in your local time, not the server's.
SCHEDULER_TIMEZONE=

# Intelligence pipeline (news + analysis) interval.
AGENT_RUN_INTERVAL_HOURS=4

# News cache TTL for deduping incoming headlines.
NEWS_CACHE_TTL_MINUTES=30

# ── Auto news reactions ──
# When the intelligence pipeline writes high-impact signals, the orchestrator
# auto-fires a TradingAdvisor "react to" call. Cost-control via dedupe +
# per-run cap.
NEWS_REACTIONS_ENABLED=true
NEWS_REACTION_MIN_CONFIDENCE=0.8
NEWS_REACTIONS_PER_RUN_MAX=5
NEWS_REACTION_DEDUPE_HOURS=6

# ── Auto position-change reviews ──
# Polling job that watches broker positions and auto-fires advisor reviews
# when something meaningful changes. Set to false when BROKER_PROVIDER=none.
POSITION_REVIEWS_ENABLED=true
POSITION_POLL_INTERVAL_MINUTES=5
POSITION_QTY_CHANGE_THRESHOLD_PCT=5.0
POSITION_PNL_CHANGE_THRESHOLD_PCT=10.0
POSITION_REVIEW_DEDUPE_HOURS=4
POSITION_REVIEWS_PER_POLL_MAX=5

# ── Weekly plan cron ──
# Generates the TradingAdvisor weekly plan. Sunday evening by default so
# the plan is ready before Monday open.
WEEKLY_PLAN_ENABLED=true
WEEKLY_PLAN_DAY_OF_WEEK=sun
WEEKLY_PLAN_HOUR=21
WEEKLY_PLAN_MINUTE=0

# ── Morning brief cron ──
# Pre-market brief, fires every weekday. 06:00 BRT ≈ 05:00 EDT, ~4.5 hours
# before US market open.
MORNING_BRIEF_ENABLED=true
MORNING_BRIEF_DAY_OF_WEEK=mon-fri
MORNING_BRIEF_HOUR=6
MORNING_BRIEF_MINUTE=0

# ─────────────────────────────────────────────────────────────────────────────
# WATCHLIST
# ─────────────────────────────────────────────────────────────────────────────

# Tickers seeded into the watchlist on first boot (comma-separated).
# After first boot the watchlist lives in the DB; edit via the UI.
DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,TSLA,META,SPY,QQQ
