# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alpaca (paper trading — get free keys at alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database (SQLite for dev, swap for PostgreSQL in prod)
DATABASE_URL=sqlite:///./marketcoach.db

# Auth (empty = dev mode with no auth; set a secret for production)
API_SECRET=
# CORS origins (comma-separated, used in production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Agent behaviour
NEWS_CACHE_TTL_MINUTES=30
AGENT_RUN_INTERVAL_HOURS=4

# Watchlist tickers (comma-separated)
DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,TSLA,META,SPY,QQQ
