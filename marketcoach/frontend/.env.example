# MarketCoach frontend env vars
#
# Copy this file to .env.local (NOT .env — that gets picked up by every
# Vite mode, .env.local is dev-only) and fill in what you need. .env.local
# is gitignored at the repo root.
#
# Both variables below are OPTIONAL. If unset, the dev server talks to
# a local backend on http://localhost:8000 with no auth header — which is
# the original behaviour and fine for pure local dev.

# Backend URL the Vite dev proxy forwards /api/* to.
#   http://localhost:8000           ← local backend (default, same as unset)
#   https://<name>.up.railway.app   ← cloud backend (Phase 1 split deploy)
VITE_API_URL=

# Bearer token for the backend's require_auth. Must match the backend's
# API_SECRET env var. Leave empty when talking to a local backend that
# has API_SECRET=empty.
#
# Security: this value gets inlined into the client bundle at build time.
# That's fine for a local dev server (never exposed to the internet) but
# DO NOT build and deploy a frontend with this set to a real secret —
# it would be readable by anyone who loads the page. Production deploy
# of the frontend needs a different auth story (cookies, OAuth, reverse
# proxy injecting the header, etc.).
VITE_API_SECRET=
